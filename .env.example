# Application environment
APP_ENV=development

# Database
DATABASE_URL=sqlite:///data/ideas.db

# Server
HOST=127.0.0.1
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# AI provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
